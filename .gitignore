# ==============================================================================
# RewindVerse — Master Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/

# Next.js & Build Outputs
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# TypeScript & Cache
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts
.turbo/
**/.turbo/

# Environment Variables & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.neon

# Vercel Deployment Cache
.vercel/
**/.vercel/

# Logs & Debugging
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
# Coverage & Test Outputs
.coverage
htmlcov/
.playwright/
playwright-report/
test-results/
.venv/
venv/
ENV/

# Operating System Files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
desktop.ini
**/desktop.ini

# IDE & Editors (Keep repository settings neutral, user configs ignored)
.idea/
**/.idea/
*.swp
*.swo
*~
