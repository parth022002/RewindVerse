# ==============================================================================
# RewindVerse — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials, passwords, or access keys to version control.
# ==============================================================================

# Core Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Cloud Features (Optional — Not needed for local browser ML & Replay)
# ------------------------------------------------------------------------------

# Neon Serverless PostgreSQL Database (replace with your project endpoint)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Private S3-Compatible Object Storage (Neon Object Storage, Cloudflare R2, AWS S3, or MinIO)
AWS_ENDPOINT_URL_S3="https://<project-id>.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="ap-southeast-1"
S3_BUCKET="rewindverse-traces"

# Authentication (Auth.js / NextAuth - Optional)
# AUTH_SECRET="generate-with-openssl-rand-hex-32"
# NEXTAUTH_URL="http://localhost:3000"

# Optional Privacy-Preserving Telemetry & Monitoring
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# SENTRY_DSN=""
